# Foundry 프로젝트 엔드포인트
# 형식: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT="..."

# 배포된 모델 이름 (예: gpt-5.4)
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5.4"

# ===== RAG — Azure AI Search 연동 =====
# Azure AI Search 엔드포인트 (예: https://<your-search>.search.windows.net)
SEARCH_SERVICE_ENDPOINT="..."

# 검색 인덱스 이름 (저장소 src/06_rag_agent.py가 시드하는 기본값)
SEARCH_INDEX_NAME="maf-lab-knowledge-v1"

# 임베딩 호출용 Azure OpenAI 엔드포인트
# 형식: https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT="..."

# 임베딩 모델 배포 이름
EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-large"

# Azure OpenAI API 버전
AZURE_OPENAI_API_VERSION="2024-10-21"

# (선택) 저장소 기존 .env 이름 폴백
# PROJECT_ENDPOINT="..."
# MODEL_DEPLOYMENT_NAME="gpt-5.4"
